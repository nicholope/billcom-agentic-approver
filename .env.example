# Bill.com Agentic AP Approver — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Bill.com Developer Key
# Obtain from: Bill.com → Settings → API → Developer Keys
BILLCOM_DEV_KEY=your_dev_key_here

# Your Bill.com login email
BILLCOM_USERNAME=you@yourcompany.com

# API Sync Token — used as the password field for both v3 session auth and v2 GL/Class lookup.
# Recommended over account password for programmatic access; can be rotated independently.
# Obtain from: Bill.com → Settings → API → API Token
BILLCOM_API_TOKEN=your_api_token_here

# Your Bill.com Organization ID
# Obtain from: Bill.com → Settings → Account → Company
BILLCOM_ORG_ID=your_org_id_here

# Target environment: "production" or "stage"
BILLCOM_ENVIRONMENT=production
