# Bill.com Credentials
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.
#
# Where to find each value:
#   BILLCOM_DEV_KEY      → Bill.com → Settings → API → Developer Keys
#   BILLCOM_API_TOKEN    → Bill.com → Settings → API → API Token (used as password)
#   BILLCOM_USERNAME     → Your Bill.com login email
#   BILLCOM_ORG_ID       → Bill.com → Settings → Account → Company
#   BILLCOM_ENVIRONMENT  → "production" or "stage"

BILLCOM_DEV_KEY=your_dev_key_here
BILLCOM_API_TOKEN=your_api_token_here
BILLCOM_USERNAME=you@yourcompany.com
BILLCOM_ORG_ID=your_org_id_here
BILLCOM_ENVIRONMENT=production
